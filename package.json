{
  "name": "ChatLLM",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue --ignore-path .eslintignore --fix src --max-warnings 1000",
    "format": "prettier --write \"src/**/*.{js,vue,scss,css}\"",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "commit": "git-cz",
    "tag": "node tag.js",
    "tag:help": "node tag.js --help"
  },
  "lint-staged": {
    "*.{js,jsx,vue}": [
      "eslint --fix --rule 'no-unused-vars: error'"
    ],
    "*.{vue,css,scss}": [
      "stylelint --fix --allow-empty-input"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git",
      "czConfig": "./cz.config.js"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vue/shared": "^3.5.21",
    "@vueuse/core": "^13.5.0",
    "dayjs": "^1.11.13",
    "deepmerge": "^4.3.1",
    "element-plus": "^2.11.8",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.11.1",
    "json-stringify-safe": "^5.0.1",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.21",
    "mermaid": "^11.12.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate-2": "^2.0.32",
    "property-information": "^7.1.0",
    "qs": "^6.14.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vue": "^3.5.17",
    "vue-clipboard3": "^2.0.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@vitejs/plugin-legacy": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "archiver": "^7.0.1",
    "chalk": "^5.4.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-vue": "^9.23.0",
    "form-data": "^4.0.4",
    "husky": "^9.1.7",
    "inquirer": "^12.8.2",
    "lint-staged": "^16.1.2",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.89.2",
    "shelljs": "^0.10.0",
    "stylelint": "^16.21.1",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^7.0.0",
    "terser": "^5.43.1",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^7.0.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1"
  }
}
