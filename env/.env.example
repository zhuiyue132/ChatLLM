# API 配置示例
# 复制此文件为 .env 并填入实际配置

# OpenAI API 地址（支持兼容的 API 服务）
VITE_APP_API_BASE_URL=https://api.openai.com

# API 密钥
# 注意：生产环境建议使用服务端代理或安全的配置管理系统
VITE_APP_API_KEY=

# WebDAV 代理目标（开发环境使用 /webdav 访问时）
VITE_WEBDAV_PROXY_TARGET=https://webdav.123pan.cn/webdav

# MCP 代理目标（开发环境使用 /mcp 访问时）
# 示例：MCP 服务为 http://127.0.0.1:3845/mcp，则前端 endpoint 可填 /mcp
VITE_MCP_PROXY_TARGET=http://127.0.0.1:3845
